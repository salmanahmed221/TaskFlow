NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_REQUESTS=true

# Neon PostgreSQL (pooled connection - used by the app at runtime)
DATABASE_URL="postgresql://user:password@host/neondb?channel_binding=require&sslmode=require"

# Neon PostgreSQL (unpooled / direct connection - used by Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
